<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission
        android:name="io.motohub.android.permission.BIND_CORE_SERVICE"
        android:protectionLevel="signature" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.usb.accessory" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Handlebar buttons arrive as Bluetooth AVRCP; CONNECT is needed to read which audio
         devices are connected in the handlebar settings (runtime permission, Android 12+;
         minSdk is 34 so no legacy BLUETOOTH permission is needed). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- ThinkerRide (KOVE) dashboards pair through a BLE GATT handshake before the dash
         connects to the phone's projection servers; scanning is for that one service UUID,
         never to derive location. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <package android:name="com.google.android.projection.gearhead" />
        <package android:name="com.google.android.gms" />
        <!-- MOTO-HUB ADVANCED: Core offers it on Home only while it is missing, and without
             this entry getPackageInfo() hides it and the offer never goes away. -->
        <package android:name="io.motohub.android.pro" />
        <!-- OEM companion apps that hold the EasyConn reverse ports; see
             CompanionAppRegistry. Without a <package> entry Android hides the app from
             getPackageInfo() and the rider gets no "force-stop it" help at all. -->
        <package android:name="com.cfmoto.cfmotointernational" />
        <package android:name="com.cfmoto.motoplay" />
        <package android:name="tayo.com.ZontesIntelligence" />
        <package android:name="net.easyconn.carman" />
        <package android:name="com.carbit.easyconnect" />
    </queries>

    <application
        android:name=".MotoHubApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${appLabel}"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MotoHub">
        <!-- Sentry is initialized explicitly by MotoHubApplication after the DSN has been
             loaded from BuildConfig. Prevent the SDK provider from initializing first. -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />
        <!-- configChanges: without it a rotation tears this activity down, and every screen
             that had drilled down goes back to its tab's root, because Compose state lives in the
             activity that was just thrown away. Compose relayouts on a configuration change
             perfectly well without being recreated, so the recreation is pure loss. This also
             covers the QR scanner, which forces portrait and restores the previous orientation
             afterwards.

             `locale` and `uiMode` are deliberately absent. A language change has to re-resolve
             resources, and entering car mode is a big enough shift that the old behaviour is the
             safer one to keep. Kept in step with the ADVANCED manifest. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|density|fontScale"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/accessory_filter" />
        </activity>

        <service
            android:name=".session.ProjectionSessionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".androidauto.AndroidAutoSessionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|microphone" />

        <!-- Awake while the rider waits for the dashboard to come up with the phone in a
             pocket. `connectedDevice` because what it is waiting on is the join to the dash's
             access point - and because Android only accepts a WifiNetworkSpecifier request from
             a process at foreground-service importance or better. Holds no connection code; the
             retry stays in the activity, where the rider's cancel and the cooldown live. -->
        <service
            android:name=".session.BikeWatchService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".externaldisplay.AoaExternalService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".externaldisplay.AapAccessoryProbeService"
            android:exported="true"
            android:foregroundServiceType="connectedDevice" />

        <!--
            Optional: only acts while Handlebar buttons -> Input protocol is set to HID AND the
            rider has separately granted Accessibility for MOTO-HUB in system settings (an
            explicit grant Android requires; see HandlebarHidCaptureService.openAccessibilitySettings).
            Lets a Bluetooth HID-keyboard handlebar remote's D-pad presses reach the app no matter
            which app has focus on the TFT — D-pad keycodes are ordinary input events, unlike the
            AVRCP media keys MediaButtonBridge reads through a MediaSession.
        -->
        <service
            android:name=".feature.controls.HandlebarHidCaptureService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/handlebar_hid_capture_service" />
        </service>

        <service
            android:name=".ipc.IpcBridgeService"
            android:exported="true"
            android:foregroundServiceType="connectedDevice"
            android:permission="io.motohub.android.permission.BIND_CORE_SERVICE">
            <intent-filter>
                <action android:name="io.motohub.android.ipc.BIND_TBOX_TRANSPORT" />
            </intent-filter>
            <intent-filter>
                <action android:name="io.motohub.android.ipc.BIND_ANDROID_AUTO_RECEIVER" />
            </intent-filter>
        </service>

        <!--
            Not exported: it is only ever woken by this app's own alarm, which exists because a
            frozen process cannot honour its own timers. See TBoxRequestGiveUpAlarm.
        -->
        <receiver
            android:name=".tbox.TBoxRequestGiveUpReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
